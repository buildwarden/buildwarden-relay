@@ -80,6 +80,45 @@ pub fn args() -> Option<&'static str> {
 	None
 }
 
+/// Boot tracing for machines with no console: with `vzstop=<n>` in the
+/// device tree's bootargs, checkpoint `n` powers the machine off through
+/// PSCI, so a clean stop shows the boot got that far and a hang that it did
+/// not. Loader checkpoints are 1-8; the kernel's start at 10.
+pub fn checkpoint(n: u32) {
+	let Some(args) = crate::env::fdt().and_then(|fdt| fdt.chosen().bootargs()) else {
+		return;
+	};
+	let Some(at) = args.find("vzstop=") else {
+		return;
+	};
+	let digits = args[at + 7..].split(' ').next().unwrap_or("");
+	if digits.parse::<u32>() == Ok(n) {
+		unsafe {
+			core::arch::asm!("hvc #0", in("x0") 0x8400_0008u64, options(noreturn));
+		}
+	}
+}
+
+/// Boot tracing for a value: with `<key><k>` in the bootargs (for example
+/// `vzbit=33`), powers the machine off if bit `k` of `value` is set.
+pub fn probe_bits(key: &str, value: u64) {
+	let Some(args) = crate::env::fdt().and_then(|fdt| fdt.chosen().bootargs()) else {
+		return;
+	};
+	let Some(at) = args.find(key) else {
+		return;
+	};
+	let digits = args[at + key.len()..].split(' ').next().unwrap_or("");
+	if let Ok(bit) = digits.parse::<u32>()
+		&& bit < 64
+		&& value & (1 << bit) != 0
+	{
+		unsafe {
+			core::arch::asm!("hvc #0", in("x0") 0x8400_0008u64, options(noreturn));
+		}
+	}
+}
+
