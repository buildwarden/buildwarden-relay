+	checkpoint(13);
 	crate::mm::init();
+	checkpoint(14);
 	crate::mm::print_information();
 	CoreLocal::get().add_irq_counter();
 	env::init();
+	checkpoint(15);
 	interrupts::init();
+	checkpoint(16);
 	processor::detect_frequency();
 	crate::logging::KERNEL_LOGGER.set_time(true);
 	processor::print_information();
+	checkpoint(17);
 	systemtime::init();
+	checkpoint(18);
 	#[cfg(feature = "pci")]
 	pci::init();
+	checkpoint(19);
 
 	finish_processor_init();
