diff --git a/src/arch/aarch64/head.s b/src/arch/aarch64/head.s
new file mode 100644
index 0000000..6432db2
--- /dev/null
+++ b/src/arch/aarch64/head.s
@@ -0,0 +1,18 @@
+// arm64 Linux Image header, for hypervisors that boot the loader through the
+// Linux boot protocol (Documentation/arch/arm64/booting.rst), such as Apple's
+// Virtualization framework. link-vz.ld places it at the start of the image.
+
+.section .text.head, "ax"
+
+.global _head
+_head:
+	b	_start		// code0: branch over the header
+	.word	0		// code1
+	.quad	0		// text_offset
+	.quad	__image_size	// image_size, including .bss
+	.quad	0b0010		// flags: little-endian, 4K pages, 2M-aligned at the base of RAM
+	.quad	0		// res2
+	.quad	0		// res3
+	.quad	0		// res4
+	.ascii	"ARM\x64"	// magic
+	.word	0		// res5
diff --git a/src/arch/aarch64/link-vz.ld b/src/arch/aarch64/link-vz.ld
new file mode 100644
index 0000000..9b0a254
--- /dev/null
+++ b/src/arch/aarch64/link-vz.ld
@@ -0,0 +1,45 @@
+/*
+ * Linker script for the aarch64 loader booted as an arm64 Linux Image, as
+ * Apple's Virtualization framework (VZ) does with VZLinuxBootLoader.
+ *
+ * VZ's RAM starts at 0x70000000 and it places the image, with text_offset 0,
+ * at the start of RAM. The Image header (head.s) must be the first bytes of
+ * the flat binary, so .text.head comes first and the ELF headers are not
+ * part of any loaded segment. .bss is laid out in the file's address range so
+ * image_size covers it and VZ places nothing over it.
+ */
+
+ENTRY(_start)
+
+PHDRS
+{
+	text PT_LOAD FLAGS(5);
+	data PT_LOAD FLAGS(6);
+}
+
+SECTIONS
+{
+	. = 0x70000000;
+	__executable_start = .;
+
+	.text : {
+		KEEP(*(.text.head))
+		*(.text .text.*)
+	} :text
+	_etext = .;
+
+	.rodata : { *(.rodata .rodata.*) } :text
+	.eh_frame_hdr : { *(.eh_frame_hdr) } :text
+	.eh_frame : { KEEP(*(.eh_frame)) } :text
+
+	. = ALIGN(0x1000);
+	.data : { *(.data .data.*) } :data
+	.got : { *(.got .got.*) } :data
+	_edata = .;
+
+	.bss : { *(.bss .bss.*) *(COMMON) } :data
+	. = ALIGN(0x1000);
+	_end = .;
+
+	__image_size = _end - __executable_start;
+}
