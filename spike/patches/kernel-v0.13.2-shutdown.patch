From 62346b33f61b887c1bfdcf6b7cd5d4bf598ab148 Mon Sep 17 00:00:00 2001
From: Jeff Edwards <jeff@edwardsj.com>
Date: Sun, 8 Nov 2026 11:02:54 -0800
Subject: [PATCH] tcp: implement shutdown(), and let half-closed sockets read
 and write

shutdown() returned Ok for every direction and did nothing, so a TCP
connection could not be half-closed. Three other places assumed a
connection that is not fully open is closed:

- read() returned EIO in FinWait1/FinWait2, so after shutdown(SHUT_WR)
  the reply could not be read. A socket now reads until its receive
  buffer is empty and the peer has sent its FIN, then returns 0.
- write() returned 0 in CloseWait, so a server could not answer a client
  that had half-closed. CloseWait now sends; after our own FIN (FinWait,
  Closing, LastAck, TimeWait) or on a closed socket, write() returns
  EPIPE.
- poll() reported POLLHUP in FinWait1/FinWait2 instead of whether data
  is waiting.

shutdown(SHUT_WR) closes the smoltcp socket, which sends a FIN once the
send buffer drains and keeps receiving. shutdown(SHUT_RD) makes reads
return 0. Both fail with ENOTCONN on a closed socket.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/fd/socket/tcp.rs | 93 +++++++++++++++++++++++++++++++-------------
 1 file changed, 66 insertions(+), 27 deletions(-)

diff --git a/src/fd/socket/tcp.rs b/src/fd/socket/tcp.rs
index e262015..9b7e88b 100644
--- a/src/fd/socket/tcp.rs
+++ b/src/fd/socket/tcp.rs
@@ -2,7 +2,7 @@ use alloc::boxed::Box;
 use alloc::collections::BTreeSet;
 use alloc::sync::Arc;
 use core::future;
-use core::sync::atomic::{AtomicU16, Ordering};
+use core::sync::atomic::{AtomicBool, AtomicU16, Ordering};
 use core::task::Poll;
 
 use async_trait::async_trait;
@@ -38,6 +38,8 @@ pub struct Socket {
 	endpoint: IpEndpoint,
 	is_nonblocking: bool,
 	is_listen: bool,
+	/// Set by `shutdown(SHUT_RD)`: reads return end of file.
+	is_read_shutdown: AtomicBool,
 }
 
 impl Socket {
@@ -58,6 +60,7 @@ impl Socket {
 			endpoint,
 			is_nonblocking: false,
 			is_listen: false,
+			is_read_shutdown: AtomicBool::new(false),
 		}
 	}
 
@@ -121,7 +124,11 @@ impl ObjectInterface for Socket {
 			for handle in self.handle.iter() {
 				let socket = nic.get_mut_socket::<tcp::Socket<'_>>(*handle);
 				match socket.state() {
-					tcp::State::Closed | tcp::State::Closing | tcp::State::CloseWait => {
+					tcp::State::Closed
+					| tcp::State::Closing
+					| tcp::State::CloseWait
+					| tcp::State::LastAck
+					| tcp::State::TimeWait => {
 						let available = PollEvent::POLLOUT
 							| PollEvent::POLLWRNORM
 							| PollEvent::POLLWRBAND
@@ -136,9 +143,6 @@ impl ObjectInterface for Socket {
 							return Poll::Ready(Ok(ret));
 						}
 					}
-					tcp::State::FinWait1 | tcp::State::FinWait2 | tcp::State::TimeWait => {
-						return Poll::Ready(Ok(PollEvent::POLLHUP));
-					}
 					tcp::State::Listen => {
 						socket.register_recv_waker(cx.waker());
 						socket.register_send_waker(cx.waker());
@@ -146,7 +150,10 @@ impl ObjectInterface for Socket {
 					_ => {
 						let mut available = PollEvent::empty();
 
-						if socket.can_recv() || socket.may_recv() && self.is_listen {
+						if socket.can_recv()
+							|| socket.may_recv() && self.is_listen
+							|| self.is_read_shutdown.load(Ordering::Relaxed)
+						{
 							// In case, we just establish a fresh connection in non-blocking mode, we try to read data.
 							available.insert(
 								PollEvent::POLLIN | PollEvent::POLLRDNORM | PollEvent::POLLRDBAND,
@@ -186,15 +193,23 @@ impl ObjectInterface for Socket {
 	}
 
 	async fn read(&self, buffer: &mut [u8]) -> io::Result<usize> {
+		if self.is_read_shutdown.load(Ordering::Relaxed) {
+			return Ok(0);
+		}
+
 		future::poll_fn(|cx| {
 			self.with(|socket| {
-				let state = socket.state();
-				match state {
-					tcp::State::Closed => Poll::Ready(Ok(0)),
-					tcp::State::FinWait1
-					| tcp::State::FinWait2
-					| tcp::State::Listen
-					| tcp::State::TimeWait => Poll::Ready(Err(Errno::Io)),
+				match socket.state() {
+					tcp::State::Listen => Poll::Ready(Err(Errno::Io)),
+					// Still connecting.
+					tcp::State::SynSent | tcp::State::SynReceived => {
+						if self.is_nonblocking {
+							Poll::Ready(Err(Errno::Again))
+						} else {
+							socket.register_recv_waker(cx.waker());
+							Poll::Pending
+						}
+					}
 					_ => {
 						if socket.can_recv() {
 							Poll::Ready(
@@ -206,9 +221,11 @@ impl ObjectInterface for Socket {
 									})
 									.map_err(|_| Errno::Io),
 							)
-						} else if state == tcp::State::CloseWait {
-							// The local end-point has received a connection termination request
-							// and not data are in the receive buffer => return 0 to close the connection
+						} else if !socket.may_recv() {
+							// The peer has finished sending, or the connection is
+							// gone, and the receive buffer is empty: end of file.
+							// After our own shutdown(SHUT_WR), reads go on until the
+							// peer's FIN.
 							Poll::Ready(Ok(0))
 						} else if self.is_nonblocking {
 							Poll::Ready(Err(Errno::Again))
@@ -230,13 +247,16 @@ impl ObjectInterface for Socket {
 			let n = future::poll_fn(|cx| {
 				self.with(|socket| {
 					match socket.state() {
-						tcp::State::Closed | tcp::State::Closing | tcp::State::CloseWait => {
-							Poll::Ready(Ok(0))
-						}
-						tcp::State::FinWait1
+						// We have sent our FIN (shutdown(SHUT_WR) or close), or the
+						// connection is gone. Not CloseWait: the peer having
+						// finished sending does not stop us.
+						tcp::State::Closed
+						| tcp::State::Closing
+						| tcp::State::LastAck
+						| tcp::State::FinWait1
 						| tcp::State::FinWait2
-						| tcp::State::Listen
-						| tcp::State::TimeWait => Poll::Ready(Err(Errno::Io)),
+						| tcp::State::TimeWait => Poll::Ready(Err(Errno::Pipe)),
+						tcp::State::Listen => Poll::Ready(Err(Errno::Io)),
 						_ => {
 							if socket.can_send() {
 								Poll::Ready(
@@ -363,6 +383,7 @@ impl ObjectInterface for Socket {
 			endpoint: self.endpoint,
 			is_nonblocking: self.is_nonblocking,
 			is_listen: false,
+			is_read_shutdown: AtomicBool::new(false),
 		};
 
 		Ok((Arc::new(async_lock::RwLock::new(socket)), endpoint))
@@ -447,12 +468,30 @@ impl ObjectInterface for Socket {
 	}
 
 	async fn shutdown(&self, how: i32) -> io::Result<()> {
-		match how {
-			SHUT_RD /* Read  */ |
-			SHUT_WR /* Write */ |
-			SHUT_RDWR /* Both */ => Ok(()),
-			_ => Err(Errno::Inval),
+		if !matches!(how, SHUT_RD | SHUT_WR | SHUT_RDWR) {
+			return Err(Errno::Inval);
 		}
+
+		if self.with(|socket| socket.state() == tcp::State::Closed) {
+			return Err(Errno::Notconn);
+		}
+
+		if how == SHUT_RD || how == SHUT_RDWR {
+			self.is_read_shutdown.store(true, Ordering::Relaxed);
+		}
+
+		if how == SHUT_WR || how == SHUT_RDWR {
+			// smoltcp's close() sends a FIN once the send buffer drains and
+			// goes on receiving: a half-close.
+			let mut guard = NIC.lock();
+			let nic = guard.as_nic_mut().unwrap();
+			for handle in self.handle.iter() {
+				nic.get_mut_socket::<tcp::Socket<'_>>(*handle).close();
+			}
+			nic.poll_common(crate::executor::network::now());
+		}
+
+		Ok(())
 	}
 
 	async fn status_flags(&self) -> io::Result<fd::StatusFlags> {
