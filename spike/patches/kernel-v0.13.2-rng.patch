+				let irq = device.get_irq().unwrap();
+				crate::arch::interrupts::add_irq_name(irq, "virtio");
+				Ok(VirtioDriver::Rng(alloc::boxed::Box::new(virt_rng_drv)))
+			}
+			Err(virtio_error) => {
+				error!("Virtio entropy driver could not be initialized with device: {device_id:x}");
+				Err(DriverError::InitVirtioDevFail(virtio_error))
+			}
+		},
 		#[cfg(feature = "virtio-vsock")]
 		virtio::Id::Vsock => match VirtioVsockDriver::init(device) {
 			Ok(virt_sock_drv) => {
@@ -763,6 +778,8 @@ pub(crate) enum VirtioDriver {
 		feature = "virtio-net",
 	))]
 	Net(alloc::boxed::Box<VirtioNetDriver>),
+	#[cfg(feature = "virtio-rng")]
+	Rng(alloc::boxed::Box<VirtioRngDriver>),
 	#[cfg(feature = "virtio-vsock")]
 	Vsock(alloc::boxed::Box<VirtioVsockDriver>),
 }
diff --git a/src/entropy.rs b/src/entropy.rs
index f286b40..06692ca 100644
--- a/src/entropy.rs
+++ b/src/entropy.rs
@@ -1,7 +1,8 @@
 //! Cryptographically secure random data generation.
 //!
 //! This currently uses a ChaCha-based generator (the same one Linux uses!) seeded
-//! with random data provided by the processor.
+//! with random data provided by the processor or, failing that, by a virtio
+//! entropy device.
 
 use hermit_sync::InterruptTicketMutex;
 use rand_chacha::ChaCha20Rng;
@@ -25,6 +26,21 @@ struct Pool {
 
 static POOL: InterruptTicketMutex<Option<Pool>> = InterruptTicketMutex::new(None);
 
+/// Returns a seed from the processor or, failing that, the virtio entropy device.
+fn seed() -> Option<[u8; 32]> {
+	seed_entropy().or_else(|| {
+		#[cfg(feature = "virtio-rng")]
+		{
+			let mut seed = [0; 32];
+			if crate::drivers::rng::fill(&mut seed) {
+				return Some(seed);
+			}
+		}
+
+		None
+	})
+}
+
 /// Fills `buf` with random data, respecting the options in `flags`.
 ///
 /// Returns the number of bytes written or `-ENOSYS` if the system does not support
@@ -35,7 +51,7 @@ pub fn read(buf: &mut [u8], _flags: Flags) -> isize {
 	let pool = match pool {
 		Some(pool) if now.saturating_sub(pool.last_reseed) <= RESEED_INTERVAL => pool,
 		pool => {
-			let Some(seed) = seed_entropy() else {
+			let Some(seed) = seed() else {
 				return -i32::from(Errno::Nosys) as isize;
 			};
 
diff --git a/src/executor/device.rs b/src/executor/device.rs
index 8b8ae5d..a747863 100644
--- a/src/executor/device.rs
+++ b/src/executor/device.rs
@@ -65,9 +65,18 @@ impl<'a> NetworkInterface<'a> {
 		info!("{:?}", capabilities.checksum);
 		info!("MTU: {} bytes", capabilities.max_transmission_unit);
 
-		// use the current time based on the wall-clock time as seed
+		// smoltcp draws TCP initial sequence numbers and ephemeral ports from
+		// this seed, so take it from the entropy pool; the wall clock is a
+		// guessable last resort.
 		let mut config = Config::new(hardware_addr);
-		config.random_seed = (arch::kernel::systemtime::now_micros()) / 1_000_000;
+		let mut seed = [0; 8];
+		config.random_seed = if crate::entropy::read(&mut seed, crate::entropy::Flags::empty()) > 0
+		{
+			u64::from_ne_bytes(seed)
+		} else {
+			warn!("No entropy source: seeding the network stack from the wall clock");
+			(arch::kernel::systemtime::now_micros()) / 1_000_000
+		};
 		if capabilities.medium == Medium::Ethernet {
 			config.hardware_addr = hardware_addr;
 		}
diff --git a/src/syscalls/entropy.rs b/src/syscalls/entropy.rs
index cb34d32..b2f7d91 100644
--- a/src/syscalls/entropy.rs
+++ b/src/syscalls/entropy.rs
@@ -31,18 +31,13 @@ unsafe fn read_entropy(buf: *mut u8, len: usize, flags: u32) -> isize {
 		slice::from_raw_parts_mut(buf, len)
 	};
 
+	// Fails closed: without a seed there is no cryptographically secure data
+	// to return, and the caller must hear so rather than get guessable bytes.
 	let ret = entropy::read(buf, flags);
 	if ret < 0 {
-		warn!("Unable to read entropy! Fallback to a naive implementation!");
-		for byte in &mut *buf {
-			*byte = (generate_park_miller_lehmer_random_number() & 0xff)
-				.try_into()
-				.unwrap();
-		}
-		buf.len().try_into().unwrap()
-	} else {
-		ret
+		error!("No entropy source: the processor has none and there is no virtio entropy device");
 	}
+	ret
 }
 
 /// Fill `len` bytes in `buf` with cryptographically secure random data.
