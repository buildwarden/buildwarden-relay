From f2480773f7cd3bea0b6798c8c91adaa7ba24ea47 Mon Sep 17 00:00:00 2001
From: Jeff Edwards <jeff@edwardsj.com>
Date: Sat, 7 Nov 2026 17:05:09 -0800
Subject: [PATCH] vsock: fix guest-initiated connections and peer shutdown

- connect() stored the peer's CID in self.port, losing the local port.
- A Response marked the socket connected but never woke connect(), and
  never recorded the peer's buf_alloc, so writes saw no credit and blocked.
- A Shutdown or Rst never woke readers, so read() did not return 0; an Rst
  was answered with another Rst.
- A Request for a port nobody listens on was dropped, so the peer's connect
  hung; it is now reset.
---
 src/executor/vsock.rs  | 17 ++++++++++++++++-
 src/fd/socket/vsock.rs |  2 +-
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/src/executor/vsock.rs b/src/executor/vsock.rs
index f992a47..74d9192 100644
--- a/src/executor/vsock.rs
+++ b/src/executor/vsock.rs
@@ -79,6 +79,11 @@ async fn vsock_run() {
 			let header_cid: u32 = header.src_cid.to_ne().try_into().unwrap();
 
 			let Some(raw) = vsock_guard.get_mut_socket(port) else {
+				// Nothing listens on the port: reset, so the peer's connect
+				// fails at once instead of waiting.
+				if op != Op::Rst {
+					hdr = Some(*header);
+				}
 				return;
 			};
 
@@ -110,15 +115,25 @@ async fn vsock_run() {
 				} else {
 					trace!("Receive message from invalid source {header_cid}");
 				}
-			} else if op == Op::Shutdown {
+			} else if op == Op::Shutdown || op == Op::Rst {
+				// The peer is done (or gone): readers see end of stream once
+				// the buffer drains. A reset is not answered.
 				if raw.remote_cid == header_cid {
 					raw.state = VsockState::Shutdown;
+					raw.rx_waker.wake();
+					raw.tx_waker.wake();
 				} else {
 					trace!("Receive message from invalid source {header_cid}");
 				}
 			} else if op == Op::Response && type_ == Type::Stream {
 				if raw.remote_cid == header_cid && raw.state == VsockState::Connecting {
 					raw.state = VsockState::Connected;
+					// The peer's credit, which writes wait on, and the waiting
+					// connect.
+					raw.peer_buf_alloc = header.buf_alloc.to_ne();
+					raw.peer_fwd_cnt = header.fwd_cnt.to_ne();
+					raw.rx_waker.wake();
+					raw.tx_waker.wake();
 				}
 			} else if raw.remote_cid == header_cid {
 				hdr = Some(*header);
diff --git a/src/fd/socket/vsock.rs b/src/fd/socket/vsock.rs
index 949a471..bd77010 100644
--- a/src/fd/socket/vsock.rs
+++ b/src/fd/socket/vsock.rs
@@ -161,7 +161,7 @@ impl ObjectInterface for Socket {
 				const HEADER_SIZE: usize = mem::size_of::<Hdr>();
 				let port = VSOCK_MAP.lock().connect(ep.port, ep.cid)?;
 				self.port = port;
-				self.port = ep.cid;
+				self.cid = ep.cid;
 
 				future::poll_fn(|cx| {
 					if let Some(mut driver_guard) = hardware::get_vsock_driver().unwrap().try_lock()
