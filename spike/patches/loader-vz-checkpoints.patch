+/// Boot tracing for machines with no console: with `vzstop=<n>` in the
+/// device tree's bootargs, checkpoint `n` powers the machine off through
+/// PSCI, so a clean stop shows the boot got that far and a hang that it did
+/// not.
+#[cfg(feature = "vz")]
+pub fn checkpoint(n: u32) {
+	let Some(args) = fdt().chosen().bootargs() else {
+		return;
+	};
+	let Some(at) = args.find("vzstop=") else {
+		return;
+	};
+	let digits = args[at + 7..].split(' ').next().unwrap_or("");
+	if digits.parse::<u32>() == Ok(n) {
+		unsafe {
+			asm!("hvc #0", in("x0") 0x8400_0008u64, options(noreturn));
+		}
+	}
+}
+
+#[cfg(not(feature = "vz"))]
+pub fn checkpoint(_n: u32) {}
+
 pub fn find_kernel() -> &'static [u8] {
